import re


def find_hashtags(text: str) -> list[str]:
    pattern = r"(?<!\w)#([\w]+)"

    return re.findall(pattern, text)


sentence = """
Вивчаємо #Python, працюємо з #regexp
і пишемо #домашнє_завдання
"""

hashtags = find_hashtags(sentence)

print(hashtags)




